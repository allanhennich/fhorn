# ─── Banco de Dados (MariaDB) ────────────────────────────────────────
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# ─── Google Analytics 4 ─────────────────────────────────────────────
# Property ID do GA4 (encontrado em Admin > Property Settings)
GA_PROPERTY_ID=
# Coloque o arquivo ga-credentials.json na raiz do projeto

# ─── Google Tag Manager ─────────────────────────────────────────────
# ID do contêiner (GTM-XXXXXXX). Lido no build: rode npm run build depois de alterar.
# Padrão no código: GTM-M97D9VRW. Deixe vazio para desativar.
# PUBLIC_GTM_ID=GTM-M97D9VRW

# ─── App ─────────────────────────────────────────────────────────────
NODE_ENV=development
