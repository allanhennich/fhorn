---
import { getActiveBoxes } from '../../data/admin/boxes';
import StorageCard from '../storage/StorageCard.astro';

const storageUnits = await getActiveBoxes();
---

<section class="section storage-section" id="nossos-espacos">
  <div class="container">
    <div class="storage-header">
      <span class="section-label">Nossos espaços</span>
      <h2>O tamanho certo para cada necessidade</h2>
      <p class="storage-intro">
        De pequenos volumes a mudanças completas, temos espaços seguros e acessíveis com diferentes capacidades.
      </p>
    </div>

    <div class="storage-list">
      {storageUnits.map((unit, i) => (
        <StorageCard unit={unit} eager={i < 2} />
      ))}
    </div>

    <div class="storage-cta-wrap">
      <p class="storage-cta-text">Não sabe qual tamanho escolher?</p>
      <a href="/simulador-de-espaco/" class="btn btn-secondary btn-lg">
        Use nosso simulador
      </a>
    </div>
  </div>
</section>

<style>
  .storage-section {
    background-color: var(--color-neutral-50);
  }

  .storage-header {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 3rem;
  }

  .storage-intro {
    font-size: var(--text-body-lg);
    color: var(--color-neutral-600);
    margin-top: 0.75rem;
  }

  .storage-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .storage-cta-wrap {
    text-align: center;
    margin-top: 3rem;
  }

  .storage-cta-text {
    color: var(--color-neutral-600);
    margin-bottom: 0.75rem;
  }
</style>
