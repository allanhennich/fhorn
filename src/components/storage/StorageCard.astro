---
import type { StorageUnit } from '../../data/storageUnits';
import { floorArea, formatMeters } from '../../data/storageUnits';

interface Props {
  unit: StorageUnit;
  eager?: boolean;
}

const { unit, eager = false } = Astro.props;
---

<article class="storage-item">
  <div class="item-image">
    <picture>
      <source srcset={unit.image.src} type="image/webp" />
      <img
        src={unit.image.fallback}
        alt={unit.image.alt}
        width={unit.image.width}
        height={unit.image.height}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        fetchpriority={eager ? "high" : "auto"}
      />
    </picture>
    <span class="item-volume-badge">{unit.volumeLabel}</span>
  </div>

  <div class="item-content">
    <div class="item-body">
      <div class="item-header">
        <h3 class="item-title">{unit.name}</h3>
        <span class="item-volume">{unit.volumeLabel}</span>
      </div>

      <p class="item-dimensions">
        {unit.dimensionLabel} &middot; {formatMeters(floorArea(unit))} m²
      </p>

      <p class="item-description">{unit.description}</p>

      <div class="item-tags">
        {unit.sampleItems.slice(0, 3).map((obj) => (
          <span class="item-tag">{obj}</span>
        ))}
      </div>
    </div>

    <div class="item-actions">
      <a href={`/boxes/${unit.slug}/`} class="btn btn-ghost item-btn">
        Detalhes
      </a>
      <a href="/contato/" class="btn btn-primary item-btn">
        Orçamento
      </a>
    </div>
  </div>
</article>

<style>
  /* ── Mobile-first: horizontal compact card ── */
  .storage-item {
    background: white;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-neutral-200);
    display: flex;
    flex-direction: row;
    overflow: hidden;
    transition: box-shadow 0.2s ease;
  }

  .storage-item:hover {
    box-shadow: var(--shadow-card-hover);
  }

  /* Image — small square on mobile */
  .item-image {
    position: relative;
    flex-shrink: 0;
    width: 100px;
    background-color: var(--color-neutral-50);
    overflow: hidden;
  }

  .item-image picture,
  .item-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .item-volume-badge {
    position: absolute;
    bottom: 0.375rem;
    left: 0.375rem;
    background-color: var(--color-brand-700);
    color: white;
    font-size: 0.625rem;
    font-weight: 700;
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-sm);
    line-height: 1.4;
  }

  /* Content wrapper */
  .item-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  /* Body */
  .item-body {
    padding: 0.75rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .item-header {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .item-title {
    font-size: var(--text-body);
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
  }

  .item-volume {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-brand-600);
    white-space: nowrap;
  }

  .item-dimensions {
    font-size: 0.6875rem;
    color: var(--color-neutral-500);
    font-variant-numeric: tabular-nums;
    margin: 0;
    line-height: 1.3;
  }

  .item-description {
    font-size: var(--text-xs);
    color: var(--color-neutral-600);
    line-height: 1.4;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .item-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0.125rem;
  }

  .item-tag {
    font-size: 0.625rem;
    color: var(--color-brand-700);
    background-color: var(--color-brand-50);
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  /* Actions */
  .item-actions {
    padding: 0 0.75rem 0.75rem;
    display: flex;
    gap: 0.375rem;
  }

  .item-btn {
    flex: 1;
    font-size: 0.6875rem;
    padding: 0.5rem 0.5rem;
    text-align: center;
    white-space: nowrap;
  }

  /* ── Tablet (≥640px): bigger image ── */
  @media (min-width: 640px) {
    .item-image {
      width: 140px;
    }

    .item-volume-badge {
      font-size: var(--text-xs);
      padding: 0.175rem 0.5rem;
    }

    .item-body {
      padding: 1rem;
      gap: 0.375rem;
    }

    .item-title {
      font-size: var(--text-h4);
    }

    .item-volume {
      font-size: var(--text-sm);
    }

    .item-dimensions {
      font-size: var(--text-xs);
    }

    .item-description {
      font-size: var(--text-sm);
      -webkit-line-clamp: 3;
    }

    .item-tag {
      font-size: var(--text-xs);
      padding: 0.175rem 0.5rem;
    }

    .item-actions {
      padding: 0 1rem 1rem;
      gap: 0.5rem;
    }

    .item-btn {
      font-size: var(--text-xs);
      padding: 0.625rem 0.75rem;
    }
  }

  /* ── Desktop (≥768px): full horizontal list row ── */
  @media (min-width: 768px) {
    .storage-item {
      align-items: center;
    }

    .item-image {
      width: 160px;
      min-height: 160px;
      align-self: stretch;
    }

    .item-content {
      flex-direction: row;
      align-items: center;
    }

    .item-body {
      padding: 1.25rem 1.5rem;
      gap: 0.375rem;
    }

    .item-description {
      -webkit-line-clamp: unset;
      overflow: visible;
    }

    .item-actions {
      flex-direction: column;
      padding: 1.25rem 1.5rem 1.25rem 0;
      min-width: 150px;
    }
  }

  /* ── Large desktop (≥1024px) ── */
  @media (min-width: 1024px) {
    .item-image {
      width: 200px;
      min-height: 200px;
    }
  }
</style>
