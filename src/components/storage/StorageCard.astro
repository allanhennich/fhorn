---
import type { AdminBox } from '../../data/admin/types';
import { siteConfig } from '../../config/site';

interface Props {
  unit: AdminBox;
  eager?: boolean;
}

const { unit, eager = false } = Astro.props;
const whatsappUrl = `https://wa.me/${siteConfig.contact.whatsappRaw}?text=${encodeURIComponent(`Olá! Tenho interesse no ${unit.name} (${unit.volumeLabel}). Gostaria de mais informações.`)}`;

const floorArea = Math.round(unit.dimensions.width * unit.dimensions.depth * 100) / 100;
const floorAreaLabel = floorArea.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

const hasPrice = unit.priceVisible && unit.price != null;
const hasPromo = hasPrice && unit.pricePromotional != null && unit.pricePromotional < unit.price!;

function formatCurrency(value: number): string {
  return value.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
}
---

<article class="storage-item">
  <div class="item-image-col">
    <div class="item-image">
      <picture>
        <source srcset={unit.image.src} type="image/webp" />
        <img
          src={unit.image.fallback}
          alt={unit.image.alt}
          width={unit.image.width}
          height={unit.image.height}
          loading={eager ? "eager" : "lazy"}
          decoding="async"
          fetchpriority={eager ? "high" : "auto"}
        />
      </picture>
    </div>
  </div>

  <div class="item-content">
    <div class="item-body">
      <span class="item-volume-badge">{unit.volumeLabel}</span>

      <h3 class="item-title">{unit.name}</h3>

      <p class="item-dimensions">
        {unit.dimensionLabel} &middot; {floorAreaLabel} m²
      </p>

      <p class="item-description">{unit.description}</p>

      <div class="item-tags">
        {unit.sampleItems.slice(0, 3).map((obj) => (
          <span class="item-tag">{obj}</span>
        ))}
      </div>
    </div>

    {hasPrice && (
      <div class="item-price">
        {hasPromo ? (
          <>
            <span class="item-price-old">{formatCurrency(unit.price!)}</span>
            <span class="item-price-current">{formatCurrency(unit.pricePromotional!)}<span class="item-price-period">/mês</span></span>
          </>
        ) : (
          <span class="item-price-current">{formatCurrency(unit.price!)}<span class="item-price-period">/mês</span></span>
        )}
      </div>
    )}

    <div class="item-actions">
      <a href={`/boxes/${unit.slug}/`} class="btn btn-ghost item-btn">
        Detalhes
      </a>
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary item-btn">
        Quero Esse
      </a>
    </div>
  </div>
</article>

<style>
  /* ── Mobile-first: vertical block card ── */
  .storage-item {
    background: white;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-neutral-200);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: box-shadow 0.2s ease;
  }

  .storage-item:hover {
    box-shadow: var(--shadow-card-hover);
  }

  /* Image — full width on mobile */
  .item-image-col {
    width: 100%;
  }

  .item-image {
    position: relative;
    background-color: var(--color-neutral-50);
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .item-image picture,
  .item-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Content wrapper */
  .item-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  /* Body */
  .item-body {
    padding: 0.875rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  /* Volume badge */
  .item-volume-badge {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.6875rem;
    font-weight: 700;
    color: white;
    background-color: var(--color-brand-700);
    padding: 0.2rem 0.625rem;
    border-radius: var(--radius-sm);
    line-height: 1.4;
  }

  .item-title {
    font-size: var(--text-h4);
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
  }

  .item-dimensions {
    font-size: 0.6875rem;
    color: var(--color-neutral-500);
    font-variant-numeric: tabular-nums;
    margin: 0;
    line-height: 1.3;
  }

  .item-description {
    font-size: var(--text-xs);
    color: var(--color-neutral-600);
    line-height: 1.4;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .item-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0.125rem;
  }

  .item-tag {
    font-size: 0.625rem;
    color: var(--color-brand-700);
    background-color: var(--color-brand-50);
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  /* Price — visible on mobile */
  .item-price {
    padding: 0 0.875rem;
  }

  .item-price-old {
    display: block;
    font-size: 0.6875rem;
    color: var(--color-neutral-400);
    text-decoration: line-through;
    line-height: 1.2;
  }

  .item-price-current {
    display: block;
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-brand-700);
    line-height: 1.2;
  }

  .item-price-period {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--color-neutral-500);
  }

  /* Actions */
  .item-actions {
    padding: 0.625rem 0.875rem 0.875rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .item-btn {
    flex: 1;
    font-size: 0.75rem;
    padding: 0.625rem 0.5rem;
    text-align: center;
    white-space: nowrap;
  }

  /* ── Tablet (≥640px): 2-column grid ── */
  @media (min-width: 640px) {
    .item-image {
      aspect-ratio: 1 / 1;
    }

    .item-body {
      padding: 1rem;
      gap: 0.375rem;
    }

    .item-volume-badge {
      font-size: var(--text-xs);
    }

    .item-title {
      font-size: var(--text-h4);
    }

    .item-dimensions {
      font-size: var(--text-xs);
    }

    .item-description {
      font-size: var(--text-sm);
      -webkit-line-clamp: 3;
    }

    .item-tag {
      font-size: var(--text-xs);
      padding: 0.175rem 0.5rem;
    }

    .item-price {
      padding: 0 1rem;
    }

    .item-actions {
      padding: 0.75rem 1rem 1rem;
      gap: 0.5rem;
    }

    .item-btn {
      font-size: var(--text-xs);
      padding: 0.625rem 0.75rem;
    }
  }

  /* ── Desktop (≥768px): horizontal list row ── */
  @media (min-width: 768px) {
    .storage-item {
      flex-direction: row;
      align-items: center;
    }

    .item-image-col {
      width: 160px;
      min-height: 160px;
      align-self: stretch;
      flex-shrink: 0;
    }

    .item-image {
      aspect-ratio: unset;
      height: 100%;
    }

    .item-content {
      flex-direction: row;
      align-items: center;
    }

    .item-body {
      padding: 1.25rem 1.5rem;
      gap: 0.375rem;
    }

    .item-volume-badge {
      font-size: 0.75rem;
      padding: 0.25rem 0.75rem;
    }

    .item-description {
      -webkit-line-clamp: unset;
      overflow: visible;
    }

    .item-actions {
      flex-direction: column;
      padding: 1.25rem 1.5rem 1.25rem 0;
      min-width: 150px;
    }

    .item-price {
      text-align: center;
      padding: 0;
      margin-bottom: 0.25rem;
    }
  }

  /* ── Large desktop (≥1024px) ── */
  @media (min-width: 1024px) {
    .item-image-col {
      width: 200px;
      min-height: 200px;
    }

    .item-price-current {
      font-size: 1.375rem;
    }
  }
</style>
