---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { query } from '../../../data/admin/db';

const selectedFloor = Astro.url.searchParams.get('floor') || '';

// Get all units
const [allUnits] = await query<any[]>('SELECT * FROM box_units ORDER BY floor, side, CAST(box_number AS UNSIGNED)');

// Group by floor
const floorOrder = ['terreo', '1andar', 'subsolo1', 'subsolo2'];
const floorLabels: Record<string, string> = {
  terreo: 'Térreo',
  '1andar': '1º Andar',
  subsolo1: 'Subsolo 1',
  subsolo2: 'Subsolo 2',
};

const floorGroups: Record<string, { label: string; units: any[]; stats: Record<string, number> }> = {};
for (const f of floorOrder) {
  floorGroups[f] = { label: floorLabels[f], units: [], stats: { disponivel: 0, locado: 0, nao_locar: 0, uso_interno: 0, reservado: 0, manutencao: 0, total: 0 } };
}
allUnits.forEach((u: any) => {
  if (floorGroups[u.floor]) {
    floorGroups[u.floor].units.push(u);
    floorGroups[u.floor].stats[u.status] = (floorGroups[u.floor].stats[u.status] || 0) + 1;
    floorGroups[u.floor].stats.total++;
  }
});

const globalStats = { disponivel: 0, locado: 0, nao_locar: 0, uso_interno: 0, total: allUnits.length };
allUnits.forEach((u: any) => { if (u.status in globalStats) globalStats[u.status as keyof typeof globalStats]++; });

const statusLabels: Record<string, string> = {
  disponivel: 'Disponível', locado: 'Locado', reservado: 'Reservado',
  manutencao: 'Manutenção', uso_interno: 'Uso interno', nao_locar: 'Não locar',
};

const statusColors: Record<string, string> = {
  disponivel: '#16a34a', locado: '#2563eb', reservado: '#f59e0b',
  manutencao: '#dc2626', uso_interno: '#8b5cf6', nao_locar: '#6b7280',
};

function rowClass(status: string): string {
  if (status === 'disponivel') return 'row-disponivel';
  if (status === 'locado') return 'row-locado';
  if (status === 'nao_locar' || status === 'manutencao') return 'row-indisponivel';
  if (status === 'uso_interno') return 'row-interno';
  if (status === 'reservado') return 'row-reservado';
  return '';
}

const selectedData = selectedFloor && floorGroups[selectedFloor] ? floorGroups[selectedFloor] : null;
---

<AdminLayout title="Inventário de Boxes">
  <div class="admin-page-header">
    <div>
      <h1>Inventário de Boxes</h1>
      <p>{allUnits.length} unidades — {globalStats.locado} locados, {globalStats.disponivel} disponíveis</p>
    </div>
  </div>

  <!-- Floor cards -->
  <div class="floor-grid">
    {floorOrder.map(f => {
      const fg = floorGroups[f];
      const isSelected = selectedFloor === f;
      return (
        <a href={isSelected ? '/admin/inventory/' : `/admin/inventory/?floor=${f}`} class={`floor-card ${isSelected ? 'floor-card-active' : ''}`}>
          <div class="floor-card-top">
            <div class="floor-card-title">{fg.label}</div>
            <div class="floor-card-total">{fg.stats.total}</div>
          </div>
          <div class="floor-card-bar">
            {fg.stats.total > 0 && (
              <>
                <div class="bar-segment" style={`width: ${((fg.stats.disponivel||0)/fg.stats.total)*100}%; background: #16a34a;`}></div>
                <div class="bar-segment" style={`width: ${((fg.stats.locado||0)/fg.stats.total)*100}%; background: #2563eb;`}></div>
                <div class="bar-segment" style={`width: ${(((fg.stats.nao_locar||0)+(fg.stats.uso_interno||0))/fg.stats.total)*100}%; background: #ea580c;`}></div>
              </>
            )}
          </div>
          <div class="floor-card-stats">
            <span><span class="stat-dot" style="background: #16a34a;"></span> {fg.stats.disponivel || 0} disp.</span>
            <span><span class="stat-dot" style="background: #2563eb;"></span> {fg.stats.locado || 0} loc.</span>
            <span><span class="stat-dot" style="background: #ea580c;"></span> {(fg.stats.nao_locar || 0) + (fg.stats.uso_interno || 0)} indisp.</span>
          </div>
        </a>
      );
    })}
  </div>

  <!-- Selected floor detail -->
  {selectedData ? (
    <div class="floor-detail">
      <div class="floor-header">
        <div class="floor-header-left">
          <h2 class="floor-title">{selectedData.label}</h2>
          <span class="floor-count">{selectedData.stats.total} boxes</span>
        </div>
        <div class="floor-header-stats">
          <span class="floor-pill" style="background: #dcfce7; color: #16a34a;">{selectedData.stats.disponivel || 0} disponíveis</span>
          <span class="floor-pill" style="background: #dbeafe; color: #2563eb;">{selectedData.stats.locado || 0} locados</span>
          <span class="floor-pill" style="background: #fff7ed; color: #ea580c;">{(selectedData.stats.nao_locar || 0) + (selectedData.stats.uso_interno || 0)} indisponíveis</span>
        </div>
      </div>

      <!-- Filtro por status - botões (desktop) -->
      <div class="status-filter status-filter-buttons">
        <span class="filter-label">Filtrar:</span>
        <button class="filter-btn filter-btn-active" data-filter="todos">Todos</button>
        <button class="filter-btn" data-filter="disponivel">Disponível</button>
        <button class="filter-btn" data-filter="locado">Locado</button>
        <button class="filter-btn" data-filter="nao_locar">Não locar</button>
        <button class="filter-btn" data-filter="uso_interno">Uso interno</button>
        <button class="filter-btn" data-filter="reservado">Reservado</button>
        <button class="filter-btn" data-filter="manutencao">Manutenção</button>
      </div>

      <!-- Filtro por status - dropdown (mobile) -->
      <div class="status-filter status-filter-select">
        <label for="statusFilter" class="filter-label">Filtrar:</label>
        <select id="statusFilterSelect" class="filter-select">
          <option value="todos">Todos</option>
          <option value="disponivel">Disponível</option>
          <option value="locado">Locado</option>
          <option value="nao_locar">Não locar</option>
          <option value="uso_interno">Uso interno</option>
          <option value="reservado">Reservado</option>
          <option value="manutencao">Manutenção</option>
        </select>
      </div>

      <div class="admin-card">
        <div class="admin-card-body" style="padding: 0; overflow-x: auto;">
          <table class="admin-table inv-table" id="inventoryTable">
            <thead>
              <tr>
                <th>Box</th>
                <th>Lado</th>
                <th class="inv-hide-mobile">Dimensões</th>
                <th>Vol.</th>
                <th class="inv-hide-mobile">Cat.</th>
                <th>Status</th>
                <th class="inv-hide-mobile">Locatário</th>
                <th>Ações</th>
              </tr>
            </thead>
            <tbody>
              {selectedData.units.map((u: any) => (
                <tr class={rowClass(u.status)} data-status={u.status}>
                  <td><strong>{u.box_number}</strong></td>
                  <td class="inv-side">{u.side}</td>
                  <td class="inv-hide-mobile" style="font-size: 0.8rem; font-variant-numeric: tabular-nums; white-space: nowrap;">
                    {Number(u.width).toFixed(2)} × {Number(u.height).toFixed(2)} × {Number(u.depth).toFixed(2)} m
                  </td>
                  <td style="white-space: nowrap;">{Number(u.volume).toFixed(1)}</td>
                  <td class="inv-hide-mobile"><span style="font-size: 0.8rem;">{u.category}</span></td>
                  <td>
                    <span class="admin-badge" style={`background: ${statusColors[u.status]}15; color: ${statusColors[u.status]}; border: 1px solid ${statusColors[u.status]}30;`}>
                      {statusLabels[u.status] || u.status}
                    </span>
                  </td>
                  <td class="inv-hide-mobile" style="font-size: 0.8rem; max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                    {u.tenant_name || '—'}
                  </td>
                  <td>
                    <a href={`/admin/inventory/${u.id}/`} class="admin-btn admin-btn-ghost admin-btn-sm">Editar</a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  ) : (
    <div class="floor-placeholder">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 8.35V20a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8.35A2 2 0 0 1 3.26 6.5l8-3.2a2 2 0 0 1 1.48 0l8 3.2A2 2 0 0 1 22 8.35Z"/><path d="M6 18h12"/><path d="M6 14h12"/><rect width="12" height="12" x="6" y="10"/></svg>
      <p>Selecione um pavimento acima para ver os boxes</p>
    </div>
  )}
</AdminLayout>

<style>
  .floor-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 1023px) {
    .floor-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }
  }

  @media (max-width: 480px) {
    .floor-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Row colors - light mode */
  .row-disponivel { background: #f0fdf4; }
  .row-locado { background: #eff6ff; }
  .row-indisponivel { background: #fff7ed; }
  .row-interno { background: #faf5ff; }
  .row-reservado { background: #fffbeb; }

  /* Row colors - dark mode */
  :global(.admin-body.dark) .row-disponivel { background: #052e16; color: #bbf7d0; }
  :global(.admin-body.dark) .row-locado { background: #172554; color: #bfdbfe; }
  :global(.admin-body.dark) .row-indisponivel { background: #431407; color: #fed7aa; }
  :global(.admin-body.dark) .row-interno { background: #2e1065; color: #e9d5ff; }
  :global(.admin-body.dark) .row-reservado { background: #422006; color: #fef08a; }
  :global(.admin-body.dark) .row-disponivel td,
  :global(.admin-body.dark) .row-locado td,
  :global(.admin-body.dark) .row-indisponivel td,
  :global(.admin-body.dark) .row-interno td,
  :global(.admin-body.dark) .row-reservado td { color: inherit; }

  /* Filter: buttons on desktop, dropdown on mobile */
  .status-filter-buttons {
    display: flex;
  }
  .status-filter-select {
    display: none !important;
  }

  .filter-select {
    padding: 0.5rem 0.75rem;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 500;
    color: #374151;
    background: white;
    flex: 1;
  }

  /* Celular: esconde colunas da tabela, troca filtro pra dropdown */
  @media (max-width: 640px) {
    .status-filter-buttons {
      display: none !important;
    }
    .status-filter-select {
      display: flex !important;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }
    .inv-hide-mobile {
      display: none;
    }
    .inv-table .admin-badge {
      font-size: 0.65rem;
      padding: 0.1rem 0.35rem;
    }
    .inv-side {
      font-size: 0.75rem;
    }
    .floor-header {
      flex-direction: column;
      align-items: flex-start;
    }
    .floor-header-stats {
      gap: 0.375rem;
    }
    .floor-pill {
      font-size: 0.6rem;
      padding: 0.2rem 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .floor-card {
      padding: 0.75rem;
    }

    .floor-card-title {
      font-size: 0.8rem;
    }

    .floor-card-total {
      font-size: 1.25rem;
    }

    .floor-card-stats {
      font-size: 0.6rem;
      gap: 0.25rem;
    }

    .status-filter {
      gap: 0.375rem;
    }

    .filter-btn {
      font-size: 0.65rem;
      padding: 0.25rem 0.5rem;
    }

    .filter-label {
      font-size: 0.7rem;
    }

    .floor-placeholder {
      padding: 2.5rem 1rem;
    }

    .floor-placeholder svg {
      width: 36px;
      height: 36px;
    }

    .floor-placeholder p {
      font-size: 0.8rem;
    }
  }

  .floor-card {
    display: block;
    background: white;
    border: 2px solid #e5e7eb;
    border-radius: 0.625rem;
    padding: 1rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, box-shadow 0.2s;
    cursor: pointer;
  }

  .floor-card:hover {
    border-color: #dd6b20;
    box-shadow: 0 4px 12px rgba(221, 107, 32, 0.1);
  }

  .floor-card-active {
    border-color: #dd6b20;
    background: #fffaf0;
    box-shadow: 0 4px 12px rgba(221, 107, 32, 0.15);
  }

  .floor-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .floor-card-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #111827;
  }

  .floor-card-total {
    font-size: 1.5rem;
    font-weight: 800;
    color: #0c2340;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }

  .floor-card-bar {
    display: flex;
    height: 6px;
    border-radius: 3px;
    overflow: hidden;
    background: #f3f4f6;
    gap: 1px;
    margin-bottom: 0.5rem;
  }

  .bar-segment {
    height: 100%;
    border-radius: 3px;
  }

  .floor-card-stats {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    font-weight: 600;
    color: #374151;
  }

  .stat-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 3px;
    vertical-align: middle;
  }

  /* Detail section */
  .floor-detail {
    animation: fadeIn 0.3s ease;
  }

  .floor-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .floor-header-left {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .floor-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: #0c2340;
    margin: 0;
  }

  .floor-count {
    font-size: 0.8rem;
    color: #6b7280;
  }

  .floor-header-stats {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .floor-pill {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.25rem 0.625rem;
    border-radius: 99px;
  }

  .floor-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    color: #9ca3af;
    text-align: center;
    background: white;
    border-radius: 0.625rem;
    border: 2px dashed #e5e7eb;
  }

  .floor-placeholder p {
    margin-top: 1rem;
    font-size: 0.95rem;
  }

  /* Status filter */
  .status-filter {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .filter-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: #6b7280;
  }

  .filter-btn {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.3rem 0.75rem;
    border: 1px solid #d1d5db;
    border-radius: 99px;
    background: white;
    color: #374151;
    cursor: pointer;
    transition: all 0.15s;
  }

  .filter-btn:hover {
    border-color: #dd6b20;
    color: #dd6b20;
  }

  .filter-btn-active {
    background: #0c2340;
    color: white;
    border-color: #0c2340;
  }

  .filter-btn-active:hover {
    background: #0c2340;
    color: white;
    border-color: #0c2340;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script is:inline>
  function filterTable(filter) {
    const table = document.getElementById('inventoryTable');
    if (!table) return;
    table.querySelectorAll('tbody tr').forEach(row => {
      row.style.display = (filter === 'todos' || row.dataset.status === filter) ? '' : 'none';
    });
  }

  // Desktop buttons
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('filter-btn-active'));
      btn.classList.add('filter-btn-active');
      const filter = btn.dataset.filter;
      filterTable(filter);
      // Sync dropdown
      const select = document.getElementById('statusFilterSelect');
      if (select) select.value = filter;
    });
  });

  // Mobile dropdown
  document.getElementById('statusFilterSelect')?.addEventListener('change', (e) => {
    const filter = e.target.value;
    filterTable(filter);
    // Sync buttons
    document.querySelectorAll('.filter-btn').forEach(b => {
      b.classList.toggle('filter-btn-active', b.dataset.filter === filter);
    });
  });
</script>
