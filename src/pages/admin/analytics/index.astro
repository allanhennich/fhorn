---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAnalyticsSummary } from '../../../data/admin/analytics';

let totalPageViews = 0;
let todayViews = 0;
let weekViews = 0;
let monthViews = 0;
let topPages: { path: string; count: number }[] = [];
let dailyViews: { date: string; count: number }[] = [];

try {
  const analytics = await getAnalyticsSummary();
  totalPageViews = analytics.totalPageViews;
  topPages = analytics.topPages;

  const now = new Date();
  const today = now.toISOString().slice(0, 10);
  const weekAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000).toISOString().slice(0, 10);
  const monthAgo = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000).toISOString().slice(0, 10);

  // Count views for today, week, month
  for (const view of analytics.recentViews) {
    const vDate = view.timestamp.slice(0, 10);
    if (vDate === today) todayViews++;
    if (vDate >= weekAgo) weekViews++;
    if (vDate >= monthAgo) monthViews++;
  }

  // If recentViews is limited (only 20), estimate from totalPageViews
  // For proper counting, we'd need all views. For now use what we have.

  // Build daily view counts for last 30 days
  const dayMap = new Map<string, number>();
  for (let i = 29; i >= 0; i--) {
    const d = new Date(now.getTime() - i * 24 * 60 * 60 * 1000);
    const key = d.toISOString().slice(0, 10);
    dayMap.set(key, 0);
  }
  for (const view of analytics.recentViews) {
    const key = view.timestamp.slice(0, 10);
    if (dayMap.has(key)) {
      dayMap.set(key, (dayMap.get(key) ?? 0) + 1);
    }
  }
  dailyViews = Array.from(dayMap.entries()).map(([date, count]) => ({ date, count }));
} catch {
  // Data not initialized
}

const maxDailyViews = Math.max(...dailyViews.map((d) => d.count), 1);
---

<AdminLayout title="Analytics">
  <div class="admin-page-header">
    <div>
      <h1>Analytics</h1>
      <p>Acompanhe os acessos e estatisticas do site.</p>
    </div>
  </div>

  <!-- Stat Cards -->
  <div class="admin-stats-grid">
    <div class="admin-stat-card">
      <div class="admin-stat-icon blue">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>
      </div>
      <div class="admin-stat-info">
        <div class="admin-stat-value">{totalPageViews}</div>
        <div class="admin-stat-label">Total de Views</div>
      </div>
    </div>

    <div class="admin-stat-card">
      <div class="admin-stat-icon green">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <div class="admin-stat-info">
        <div class="admin-stat-value">{todayViews}</div>
        <div class="admin-stat-label">Views Hoje</div>
      </div>
    </div>

    <div class="admin-stat-card">
      <div class="admin-stat-icon orange">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
      </div>
      <div class="admin-stat-info">
        <div class="admin-stat-value">{weekViews}</div>
        <div class="admin-stat-label">Views Esta Semana</div>
      </div>
    </div>

    <div class="admin-stat-card">
      <div class="admin-stat-icon purple">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
      </div>
      <div class="admin-stat-info">
        <div class="admin-stat-value">{monthViews}</div>
        <div class="admin-stat-label">Views Este Mes</div>
      </div>
    </div>
  </div>

  <!-- Charts + Table Row -->
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
    <!-- Bar Chart -->
    <div class="admin-card" style="grid-column: 1 / -1;">
      <div class="admin-card-header">
        <h2>Views por Dia (Ultimos 30 dias)</h2>
      </div>
      <div class="admin-card-body">
        {dailyViews.length === 0 ? (
          <div class="admin-empty">
            <p>Nenhum dado de acesso registrado ainda.</p>
          </div>
        ) : (
          <div class="admin-chart">
            <div class="admin-chart-bars">
              {dailyViews.map((day) => {
                const heightPct = maxDailyViews > 0 ? (day.count / maxDailyViews) * 100 : 0;
                const dateObj = new Date(day.date + 'T12:00:00');
                const shortDate = `${dateObj.getDate()}/${dateObj.getMonth() + 1}`;
                return (
                  <div class="admin-chart-bar-wrap">
                    <div
                      class="admin-chart-bar"
                      style={`height: ${Math.max(heightPct, 1)}%;`}
                      title={`${shortDate}: ${day.count} views`}
                    >
                      <span class="admin-chart-bar-tooltip">{day.count}</span>
                    </div>
                    {dailyViews.length <= 15 && (
                      <span class="admin-chart-label">{shortDate}</span>
                    )}
                  </div>
                );
              })}
            </div>
            {dailyViews.length > 15 && (
              <div class="admin-chart-axis">
                <span style="font-size: 0.6875rem; color: var(--admin-text-muted);">
                  {(() => {
                    const first = new Date(dailyViews[0].date + 'T12:00:00');
                    return `${first.getDate()}/${first.getMonth() + 1}`;
                  })()}
                </span>
                <span style="font-size: 0.6875rem; color: var(--admin-text-muted);">
                  {(() => {
                    const last = new Date(dailyViews[dailyViews.length - 1].date + 'T12:00:00');
                    return `${last.getDate()}/${last.getMonth() + 1}`;
                  })()}
                </span>
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- Top Pages -->
  <div class="admin-card">
    <div class="admin-card-header">
      <h2>Top 10 Paginas</h2>
    </div>
    {topPages.length === 0 ? (
      <div class="admin-empty">
        <p>Nenhum dado de acesso registrado ainda.</p>
      </div>
    ) : (
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th style="width: 40px;">#</th>
              <th>Pagina</th>
              <th style="text-align: right;">Views</th>
              <th style="width: 200px;">Proporcao</th>
            </tr>
          </thead>
          <tbody>
            {topPages.map((page, i) => {
              const pct = totalPageViews > 0 ? (page.count / totalPageViews) * 100 : 0;
              return (
                <tr>
                  <td style="color: var(--admin-text-muted); font-weight: 600;">{i + 1}</td>
                  <td>
                    <code style="font-size: 0.8125rem; background: #f3f4f6; padding: 0.125rem 0.375rem; border-radius: 4px;">
                      {page.path}
                    </code>
                  </td>
                  <td style="text-align: right; font-weight: 600;">{page.count}</td>
                  <td>
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                      <div style="flex: 1; height: 8px; background: #f3f4f6; border-radius: 9999px; overflow: hidden;">
                        <div style={`width: ${pct}%; height: 100%; background: linear-gradient(90deg, #dd6b20, #ed8936); border-radius: 9999px;`}></div>
                      </div>
                      <span style="font-size: 0.75rem; color: var(--admin-text-secondary); min-width: 40px; text-align: right;">
                        {pct.toFixed(1)}%
                      </span>
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </div>
</AdminLayout>
