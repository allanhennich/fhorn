---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getBox } from '../../../data/admin/boxes';

const { id } = Astro.params;

let box = null;
try {
  box = id ? await getBox(id) : null;
} catch {
  // Data layer error
}

if (!box) {
  return Astro.redirect('/admin/boxes/');
}
---

<AdminLayout title={`Editar: ${box.name}`}>
  <div class="admin-page-header">
    <div>
      <h1>Editar Box</h1>
      <p>Editando: <strong>{box.name}</strong></p>
    </div>
    <a href="/admin/boxes/" class="admin-btn admin-btn-secondary">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      Voltar
    </a>
  </div>

  <div class="admin-card">
    <div class="admin-card-body">
      <form class="admin-form" id="boxForm" novalidate>
        <input type="hidden" id="boxId" value={box.id} />

        <!-- Name + Slug -->
        <div class="admin-form-grid">
          <div class="admin-form-group">
            <label for="name">Nome <span class="required">*</span></label>
            <input type="text" id="name" name="name" value={box.name} required />
          </div>
          <div class="admin-form-group">
            <label for="slug">Slug <span class="required">*</span></label>
            <input type="text" id="slug" name="slug" value={box.slug} required />
            <span class="admin-form-hint">Gerado automaticamente a partir do nome.</span>
          </div>
        </div>

        <!-- Volume + Volume Label -->
        <div class="admin-form-grid">
          <div class="admin-form-group">
            <label for="volume">Volume (m³) <span class="required">*</span></label>
            <input type="number" id="volume" name="volume" step="0.1" min="0" value={box.volume} required />
          </div>
          <div class="admin-form-group">
            <label for="volumeLabel">Label do Volume</label>
            <input type="text" id="volumeLabel" name="volumeLabel" value={box.volumeLabel} />
            <span class="admin-form-hint">Auto-formatado se vazio.</span>
          </div>
        </div>

        <!-- Dimensions -->
        <div class="admin-form-group">
          <label>Dimensões (metros) <span class="required">*</span></label>
          <div class="admin-form-grid-3">
            <div>
              <input type="number" id="dimWidth" name="dimWidth" step="0.01" min="0" value={box.dimensions.width} required />
            </div>
            <div>
              <input type="number" id="dimHeight" name="dimHeight" step="0.01" min="0" value={box.dimensions.height} required />
            </div>
            <div>
              <input type="number" id="dimDepth" name="dimDepth" step="0.01" min="0" value={box.dimensions.depth} required />
            </div>
          </div>
        </div>

        <div class="admin-form-group">
          <label for="dimensionLabel">Label das Dimensões</label>
          <input type="text" id="dimensionLabel" name="dimensionLabel" value={box.dimensionLabel} />
          <span class="admin-form-hint">Auto-formatado a partir das dimensões.</span>
        </div>

        <!-- Image -->
        <div class="admin-form-group">
          <label>Imagem</label>
          <!-- Preview da imagem atual -->
          <div id="imagePreview" style="margin-bottom: 1rem; display: flex; gap: 1rem; align-items: flex-start;">
            {box.image.src && (
              <div style="border: 2px solid #e2e8f0; border-radius: 8px; overflow: hidden; width: 160px; flex-shrink: 0;">
                <img src={box.image.src} alt={box.image.alt} style="width: 100%; height: auto; display: block;" />
                <div style="padding: 0.5rem; font-size: 0.75rem; color: #64748b; background: #f8fafc;">Imagem atual</div>
              </div>
            )}
            <div id="newImagePreview" style="display: none; border: 2px solid #dd6b20; border-radius: 8px; overflow: hidden; width: 160px; flex-shrink: 0;">
              <img id="newImagePreviewImg" src="" alt="Nova imagem" style="width: 100%; height: auto; display: block;" />
              <div style="padding: 0.5rem; font-size: 0.75rem; color: #dd6b20; background: #fffaf0; font-weight: 600;">Nova imagem</div>
            </div>
          </div>
          <!-- Upload de nova imagem -->
          <div style="margin-bottom: 1rem;">
            <label for="imageUpload" class="admin-btn admin-btn-secondary admin-btn-sm" style="cursor: pointer; display: inline-flex; align-items: center; gap: 0.5rem;">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/></svg>
              Trocar imagem
            </label>
            <input type="file" id="imageUpload" accept="image/*" style="display: none;" />
            <span id="uploadStatus" style="margin-left: 0.5rem; font-size: 0.8rem; color: #64748b;"></span>
          </div>
          <!-- Caminhos manuais -->
          <div class="admin-form-grid-3">
            <div class="admin-form-group" style="margin-bottom:0">
              <input type="text" id="imageSrc" name="imageSrc" value={box.image.src} />
              <span class="admin-form-hint">Caminho principal (.webp)</span>
            </div>
            <div class="admin-form-group" style="margin-bottom:0">
              <input type="text" id="imageFallback" name="imageFallback" value={box.image.fallback} />
              <span class="admin-form-hint">Fallback (.png/.jpg)</span>
            </div>
            <div class="admin-form-group" style="margin-bottom:0">
              <input type="text" id="imageAlt" name="imageAlt" value={box.image.alt} />
              <span class="admin-form-hint">Texto alternativo</span>
            </div>
          </div>
        </div>

        <!-- Description -->
        <div class="admin-form-group">
          <label for="description">Descrição</label>
          <textarea id="description" name="description">{box.description}</textarea>
        </div>

        <!-- Sample Items -->
        <div class="admin-form-group">
          <label>Itens de Exemplo</label>
          <div class="admin-list-field" id="sampleItemsList">
            <!-- Items populated by script -->
          </div>
          <button type="button" class="admin-list-add" id="addSampleItem">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
            Adicionar item
          </button>
        </div>

        <!-- Pricing -->
        <div class="admin-form-group">
          <label style="font-weight: 600; font-size: 1rem; margin-bottom: 0.25rem; display: flex; align-items: center; gap: 0.5rem;">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="2" y2="22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            Preços
          </label>
        </div>
        <div class="admin-form-grid" style="grid-template-columns: 1fr 1fr 1fr;">
          <div class="admin-form-group">
            <label for="price">Preço Mensal (R$)</label>
            <input type="number" id="price" name="price" step="0.01" min="0" placeholder="0,00" value={box.price ?? ''} />
            <span class="admin-form-hint">Valor mensal do aluguel.</span>
          </div>
          <div class="admin-form-group">
            <label for="pricePromotional">Preço Promocional (R$)</label>
            <input type="number" id="pricePromotional" name="pricePromotional" step="0.01" min="0" placeholder="0,00" value={box.pricePromotional ?? ''} />
            <span class="admin-form-hint">Deixe vazio se não houver promoção.</span>
          </div>
          <div class="admin-form-group" style="display: flex; align-items: flex-end; padding-bottom: 1.75rem;">
            <label class="admin-toggle">
              <input type="checkbox" id="priceVisible" name="priceVisible" checked={box.priceVisible} />
              <span>Exibir preço no site</span>
            </label>
          </div>
        </div>

        <!-- Active + Sort Order -->
        <div class="admin-form-grid">
          <div class="admin-form-group">
            <label class="admin-toggle">
              <input type="checkbox" id="active" name="active" checked={box.active} />
              <span>Ativo</span>
            </label>
          </div>
          <div class="admin-form-group">
            <label for="sortOrder">Ordem de exibição</label>
            <input type="number" id="sortOrder" name="sortOrder" min="0" value={box.sortOrder} />
          </div>
        </div>

        <!-- Actions -->
        <div class="admin-form-actions">
          <button type="submit" class="admin-btn admin-btn-primary" id="submitBtn">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7"/><path d="M7 3v4a1 1 0 0 0 1 1h7"/></svg>
            Salvar Alterações
          </button>
          <a href="/admin/boxes/" class="admin-btn admin-btn-secondary">Cancelar</a>
        </div>
      </form>
    </div>
  </div>

  <!-- Pass box data to client -->
  <script is:inline define:vars={{ sampleItemsData: JSON.stringify(box.sampleItems) }}>
    const existingSampleItems = JSON.parse(sampleItemsData);

    // ── Slug generation ──
    const nameInput = document.getElementById('name');
    const slugInput = document.getElementById('slug');

    function toSlug(str) {
      return str
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9\s-]/g, '')
        .replace(/[\s_]+/g, '-')
        .replace(/-+/g, '-')
        .replace(/^-|-$/g, '');
    }

    nameInput?.addEventListener('input', () => {
      slugInput.value = toSlug(nameInput.value);
    });

    // ── Auto-format labels ──
    const volumeInput = document.getElementById('volume');
    const volumeLabel = document.getElementById('volumeLabel');
    const dimW = document.getElementById('dimWidth');
    const dimH = document.getElementById('dimHeight');
    const dimD = document.getElementById('dimDepth');
    const dimLabel = document.getElementById('dimensionLabel');

    function updateVolumeLabel() {
      const v = parseFloat(volumeInput?.value);
      if (!isNaN(v) && v > 0) {
        volumeLabel.value = `${v} m\u00b3`;
      }
    }

    function updateDimLabel() {
      const w = parseFloat(dimW?.value);
      const h = parseFloat(dimH?.value);
      const d = parseFloat(dimD?.value);
      if (!isNaN(w) && !isNaN(h) && !isNaN(d) && w > 0 && h > 0 && d > 0) {
        dimLabel.value = `${w} x ${h} x ${d} m`;
      }
    }

    volumeInput?.addEventListener('input', updateVolumeLabel);
    dimW?.addEventListener('input', updateDimLabel);
    dimH?.addEventListener('input', updateDimLabel);
    dimD?.addEventListener('input', updateDimLabel);

    // ── Dynamic sample items ──
    const sampleItemsList = document.getElementById('sampleItemsList');
    const addSampleItemBtn = document.getElementById('addSampleItem');

    function addSampleItemRow(value = '') {
      const row = document.createElement('div');
      row.className = 'admin-list-item';
      row.innerHTML = `
        <input type="text" value="${value.replace(/"/g, '&quot;')}" placeholder="Ex: Caixas de mudanca" class="sample-item-input" />
        <button type="button" class="admin-btn admin-btn-ghost admin-btn-sm btn-remove-item" style="color: var(--admin-danger);">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      `;
      row.querySelector('.btn-remove-item')?.addEventListener('click', () => row.remove());
      sampleItemsList?.appendChild(row);
    }

    // Load existing items
    existingSampleItems.forEach((item) => addSampleItemRow(item));

    addSampleItemBtn?.addEventListener('click', () => addSampleItemRow());

    // ── Image upload ──
    const imageUpload = document.getElementById('imageUpload');
    const imageSrcInput = document.getElementById('imageSrc');
    const imageFallbackInput = document.getElementById('imageFallback');
    const uploadStatus = document.getElementById('uploadStatus');
    const newImagePreview = document.getElementById('newImagePreview');
    const newImagePreviewImg = document.getElementById('newImagePreviewImg');

    imageUpload?.addEventListener('change', async (e) => {
      const file = e.target.files?.[0];
      if (!file) return;

      // Show preview immediately
      const reader = new FileReader();
      reader.onload = (ev) => {
        newImagePreviewImg.src = ev.target.result;
        newImagePreview.style.display = 'block';
      };
      reader.readAsDataURL(file);

      uploadStatus.textContent = 'Enviando...';
      uploadStatus.style.color = '#dd6b20';

      const formData = new FormData();
      formData.append('file', file);
      formData.append('slug', slugInput?.value || 'box');

      try {
        const res = await fetch('/api/admin/upload', { method: 'POST', body: formData });
        const result = await res.json();

        if (res.ok && result.path) {
          imageSrcInput.value = result.path;
          imageFallbackInput.value = result.path;
          uploadStatus.textContent = 'Imagem enviada!';
          uploadStatus.style.color = '#16a34a';
          window.showToast?.('Imagem enviada com sucesso!');
        } else {
          uploadStatus.textContent = result.error || 'Erro no upload';
          uploadStatus.style.color = '#dc2626';
        }
      } catch {
        uploadStatus.textContent = 'Erro de conexão';
        uploadStatus.style.color = '#dc2626';
      }
    });

    // ── Form submission ──
    const form = document.getElementById('boxForm');
    const submitBtn = document.getElementById('submitBtn');
    const boxId = document.getElementById('boxId')?.value;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const sampleItems = Array.from(document.querySelectorAll('.sample-item-input'))
        .map((input) => input.value.trim())
        .filter(Boolean);

      const data = {
        name: nameInput?.value?.trim() || '',
        slug: slugInput?.value?.trim() || '',
        volume: parseFloat(volumeInput?.value) || 0,
        volumeLabel: volumeLabel?.value?.trim() || '',
        dimensions: {
          width: parseFloat(dimW?.value) || 0,
          height: parseFloat(dimH?.value) || 0,
          depth: parseFloat(dimD?.value) || 0,
        },
        dimensionLabel: dimLabel?.value?.trim() || '',
        image: {
          src: document.getElementById('imageSrc')?.value?.trim() || '',
          fallback: document.getElementById('imageFallback')?.value?.trim() || '',
          width: 600,
          height: 400,
          alt: document.getElementById('imageAlt')?.value?.trim() || '',
        },
        description: document.getElementById('description')?.value?.trim() || '',
        sampleItems,
        isDemonstrative: true,
        active: document.getElementById('active')?.checked ?? true,
        sortOrder: parseInt(document.getElementById('sortOrder')?.value) || 0,
        price: document.getElementById('price')?.value ? parseFloat(document.getElementById('price').value) : null,
        pricePromotional: document.getElementById('pricePromotional')?.value ? parseFloat(document.getElementById('pricePromotional').value) : null,
        priceVisible: document.getElementById('priceVisible')?.checked ?? false,
      };

      if (!data.name || !data.slug || !data.volume) {
        window.showToast?.('Preencha os campos obrigatórios.', 'error');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Salvando...';

      try {
        const res = await fetch(`/api/admin/boxes/${boxId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (res.ok) {
          window.showToast?.('Box atualizado com sucesso!');
          setTimeout(() => { window.location.href = '/admin/boxes/'; }, 800);
        } else {
          const err = await res.json().catch(() => ({}));
          window.showToast?.(err.error || 'Erro ao atualizar box.', 'error');
        }
      } catch {
        window.showToast?.('Erro de conexão.', 'error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Salvar Alterações';
      }
    });
  </script>
</AdminLayout>
