---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { query } from '../../data/admin/db';
import { getAnalyticsSummary } from '../../data/admin/analytics';

const user = Astro.locals.user as { name: string } | undefined;

// Inventory stats
const [allUnits] = await query<any[]>('SELECT * FROM box_units');
const totalUnits = allUnits.length;
const locados = allUnits.filter((u: any) => u.status === 'locado').length;
const disponiveis = allUnits.filter((u: any) => u.status === 'disponivel').length;
const naoLocar = allUnits.filter((u: any) => u.status === 'nao_locar').length;
const usoInterno = allUnits.filter((u: any) => u.status === 'uso_interno').length;
const ocupacao = totalUnits > 0 ? Math.round((locados / totalUnits) * 100) : 0;

// Per floor stats
const floorOrder = ['terreo', '1andar', 'subsolo1', 'subsolo2'];
const floorLabels: Record<string, string> = { terreo: 'Térreo', '1andar': '1º Andar', subsolo1: 'Subsolo 1', subsolo2: 'Subsolo 2' };
const floorStats: Record<string, { total: number; locado: number; disponivel: number; naoLocar: number }> = {};
for (const f of floorOrder) {
  const units = allUnits.filter((u: any) => u.floor === f);
  floorStats[f] = {
    total: units.length,
    locado: units.filter((u: any) => u.status === 'locado').length,
    disponivel: units.filter((u: any) => u.status === 'disponivel').length,
    naoLocar: units.filter((u: any) => u.status === 'nao_locar' || u.status === 'uso_interno').length,
  };
}

// Analytics
let totalPageViews = 0;
let todayViews = 0;
let weekViews = 0;
try {
  const analytics = await getAnalyticsSummary();
  totalPageViews = analytics.totalViews;
  todayViews = analytics.viewsToday;
  weekViews = analytics.viewsThisWeek;
} catch { /* analytics not ready */ }
---

<AdminLayout title="Painel">
  <div class="admin-welcome">
    <h2>Bem-vindo, {user?.name ?? 'Administrador'}!</h2>
    <p>Resumo do inventário e acessos ao site.</p>
  </div>

  <!-- Stats principais -->
  <div class="admin-stats-grid">
    <div class="admin-stat-card">
      <div class="admin-stat-icon" style="background: #dbeafe; color: #2563eb;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/></svg>
      </div>
      <div class="admin-stat-number">{totalUnits}</div>
      <div class="admin-stat-label">Total de Boxes</div>
    </div>
    <div class="admin-stat-card">
      <div class="admin-stat-icon" style="background: #dbeafe; color: #2563eb;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
      </div>
      <div class="admin-stat-number">{locados}</div>
      <div class="admin-stat-label">Locados</div>
    </div>
    <div class="admin-stat-card">
      <div class="admin-stat-icon" style="background: #dcfce7; color: #16a34a;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
      </div>
      <div class="admin-stat-number">{disponiveis}</div>
      <div class="admin-stat-label">Disponíveis</div>
    </div>
    <div class="admin-stat-card">
      <div class="admin-stat-icon" style="background: #fff7ed; color: #ea580c;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
      </div>
      <div class="admin-stat-number">{ocupacao}%</div>
      <div class="admin-stat-label">Ocupação</div>
    </div>
  </div>

  <!-- Boxes por pavimento -->
  <div class="admin-card" style="margin-bottom: 1.5rem;">
    <div class="admin-card-header">
      <h2>Boxes por Pavimento</h2>
      <a href="/admin/inventory/" class="admin-btn admin-btn-ghost admin-btn-sm">Ver inventário</a>
    </div>
    <div class="admin-card-body" style="padding: 0;">
      <div class="floor-list">
        {floorOrder.map(f => {
          const fs = floorStats[f];
          const ocp = fs.total > 0 ? Math.round((fs.locado / fs.total) * 100) : 0;
          return (
            <a href={`/admin/inventory/?floor=${f}`} class="floor-row">
              <div class="floor-row-top">
                <strong>{floorLabels[f]}</strong>
                <span class="floor-row-ocp">{ocp}%</span>
              </div>
              <div class="floor-row-bar">
                <div style={`width: ${ocp}%; background: ${ocp > 80 ? '#2563eb' : ocp > 50 ? '#f59e0b' : '#16a34a'};`}></div>
              </div>
              <div class="floor-row-nums">
                <span>{fs.total} total</span>
                <span style="color: #2563eb;">{fs.locado} loc.</span>
                <span style="color: #16a34a;">{fs.disponivel} disp.</span>
                <span style="color: #ea580c;">{fs.naoLocar} indisp.</span>
              </div>
            </a>
          );
        })}
        <div class="floor-row floor-row-total">
          <div class="floor-row-top">
            <strong>Total</strong>
            <span class="floor-row-ocp">{ocupacao}%</span>
          </div>
          <div class="floor-row-bar">
            <div style={`width: ${ocupacao}%; background: #2563eb;`}></div>
          </div>
          <div class="floor-row-nums">
            <span>{totalUnits} total</span>
            <span style="color: #2563eb;">{locados} loc.</span>
            <span style="color: #16a34a;">{disponiveis} disp.</span>
            <span style="color: #ea580c;">{naoLocar + usoInterno} indisp.</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Analytics + Ações Rápidas -->
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
    <!-- Analytics resumo -->
    <div class="admin-card">
      <div class="admin-card-header">
        <h2>Acessos ao Site</h2>
        <a href="/admin/analytics/" class="admin-btn admin-btn-ghost admin-btn-sm">Ver detalhes</a>
      </div>
      <div class="admin-card-body">
        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; text-align: center;">
          <div>
            <div style="font-size: 1.75rem; font-weight: 800; color: #0c2340;">{todayViews}</div>
            <div style="font-size: 0.75rem; color: #6b7280;">Hoje</div>
          </div>
          <div>
            <div style="font-size: 1.75rem; font-weight: 800; color: #0c2340;">{weekViews}</div>
            <div style="font-size: 0.75rem; color: #6b7280;">Esta semana</div>
          </div>
          <div>
            <div style="font-size: 1.75rem; font-weight: 800; color: #0c2340;">{totalPageViews}</div>
            <div style="font-size: 0.75rem; color: #6b7280;">Total</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Ações Rápidas -->
    <div class="admin-card">
      <div class="admin-card-header">
        <h2>Ações Rápidas</h2>
      </div>
      <div class="admin-card-body">
        <div style="display: grid; gap: 0.5rem;">
          <a href="/admin/inventory/" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem; border-radius: 8px; text-decoration: none; color: #374151; transition: background 0.15s;" onmouseover="this.style.background='#f3f4f6'" onmouseout="this.style.background='transparent'">
            <div style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; background: #dbeafe; border-radius: 8px; color: #2563eb;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 8.35V20a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8.35A2 2 0 0 1 3.26 6.5l8-3.2a2 2 0 0 1 1.48 0l8 3.2A2 2 0 0 1 22 8.35Z"/><path d="M6 18h12"/><path d="M6 14h12"/></svg>
            </div>
            <div><strong>Inventário</strong><br/><span style="font-size: 0.8rem; color: #6b7280;">Gerenciar boxes e locatários</span></div>
          </a>
          <a href="/admin/boxes/new/" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem; border-radius: 8px; text-decoration: none; color: #374151; transition: background 0.15s;" onmouseover="this.style.background='#f3f4f6'" onmouseout="this.style.background='transparent'">
            <div style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; background: #dcfce7; border-radius: 8px; color: #16a34a;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
            </div>
            <div><strong>Novo Box</strong><br/><span style="font-size: 0.8rem; color: #6b7280;">Adicionar categoria de box</span></div>
          </a>
          <a href="/" target="_blank" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem; border-radius: 8px; text-decoration: none; color: #374151; transition: background 0.15s;" onmouseover="this.style.background='#f3f4f6'" onmouseout="this.style.background='transparent'">
            <div style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; background: #fff7ed; border-radius: 8px; color: #ea580c;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
            </div>
            <div><strong>Ver Site</strong><br/><span style="font-size: 0.8rem; color: #6b7280;">Abrir site público</span></div>
          </a>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  .admin-welcome {
    margin-bottom: 1.5rem;
  }
  .admin-welcome h2 {
    font-size: 1.35rem;
    font-weight: 700;
    color: #111827;
    margin: 0 0 0.25rem;
  }
  .admin-welcome p {
    color: #6b7280;
    font-size: 0.9rem;
    margin: 0;
  }

  .floor-list {
    display: flex;
    flex-direction: column;
  }

  .floor-row {
    display: block;
    padding: 1rem 1.25rem;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid #e5e7eb;
    transition: background 0.15s;
  }

  .floor-row:hover {
    background: #f9fafb;
  }

  .floor-row:last-child {
    border-bottom: none;
  }

  .floor-row-total {
    background: #f8fafc;
  }

  .floor-row-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.375rem;
  }

  .floor-row-ocp {
    font-size: 0.9rem;
    font-weight: 700;
    color: #0c2340;
  }

  .floor-row-bar {
    height: 6px;
    background: #f3f4f6;
    border-radius: 3px;
    overflow: hidden;
    margin-bottom: 0.375rem;
  }

  .floor-row-bar div {
    height: 100%;
    border-radius: 3px;
    transition: width 0.3s;
  }

  .floor-row-nums {
    display: flex;
    gap: 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #6b7280;
  }

  @media (max-width: 768px) {
    div[style*="grid-template-columns: 1fr 1fr"] {
      grid-template-columns: 1fr !important;
    }
  }

  @media (max-width: 640px) {
    .admin-welcome h2 {
      font-size: 1.1rem;
    }
    .admin-welcome p {
      font-size: 0.8rem;
    }
    .floor-row {
      padding: 0.875rem 1rem;
    }
    .floor-row-nums {
      gap: 0.5rem;
      font-size: 0.7rem;
    }
  }
</style>
