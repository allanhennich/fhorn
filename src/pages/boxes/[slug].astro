---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { storageUnits, getUnitBySlug, formatDimensions, floorArea, formatMeters } from '../../data/storageUnits';

export function getStaticPaths() {
  return storageUnits.map((unit) => ({
    params: { slug: unit.slug },
  }));
}

const { slug } = Astro.params;
const unit = getUnitBySlug(slug as string);

if (!unit) {
  return Astro.redirect('/404');
}
---

<BaseLayout
  title={`${unit.name} - ${unit.volumeLabel}`}
  description={`${unit.name}: ${unit.description} Dimensões: ${formatDimensions(unit)}. Self Storage em Florianópolis.`}
>
  <section class="section" style="padding-top: 7rem;">
    <div class="container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Início</a></li>
          <li><a href="/boxes/">Nossos Espaços</a></li>
          <li aria-current="page">{unit.name}</li>
        </ol>
      </nav>

      <div class="box-detail">
        <!-- Visual -->
        <div class="box-visual">
          <div class="box-image-wrapper">
            <picture>
              <source srcset={unit.image.src} type="image/webp" />
              <img
                src={unit.image.fallback}
                alt={unit.image.alt}
                width={unit.image.width}
                height={unit.image.height}
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
          <div class="box-volume-display">
            <span class="volume-number">{unit.volumeLabel.replace(' m³', '')}</span>
            <span class="volume-unit">m³</span>
          </div>
        </div>

        <!-- Info -->
        <div class="box-info">
          <div class="box-demo-tag">Medidas demonstrativas</div>
          <h1>{unit.name}</h1>
          <p class="box-desc">{unit.description}</p>

          <div class="box-specs">
            <div class="spec-row">
              <span class="spec-label">Dimensões (L × A × P)</span>
              <span class="spec-value">{formatDimensions(unit)}</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">Volume</span>
              <span class="spec-value">{unit.volumeLabel}</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">Área de piso</span>
              <span class="spec-value">{formatMeters(floorArea(unit))} m²</span>
            </div>
          </div>

          <div class="box-objects">
            <h3>O que cabe neste espaço</h3>
            <ul>
              {unit.sampleItems.map((obj) => (
                <li>{obj}</li>
              ))}
            </ul>
          </div>

          <div class="box-actions">
            <a href="/contato/" class="btn btn-primary btn-lg">
              Solicitar orçamento
            </a>
            <a href="/simulador-de-espaco/" class="btn btn-secondary btn-lg">
              Simular com objetos
            </a>
          </div>

          <p class="box-disclaimer">
            As medidas e volumes apresentados são demonstrativos e podem não corresponder à disponibilidade real. Consulte nossa equipe para informações atualizadas.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .breadcrumb ol {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    font-size: var(--text-sm);
    color: var(--color-neutral-500);
  }
  .breadcrumb li:not(:last-child)::after {
    content: '/';
    margin-left: 0.5rem;
    color: var(--color-neutral-300);
  }
  .breadcrumb a {
    color: var(--color-neutral-500);
    text-decoration: none;
  }
  .breadcrumb a:hover { color: var(--color-brand-600); }

  .box-detail {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 768px) {
    .box-detail {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .box-visual {
    position: relative;
  }

  .box-image-wrapper {
    background: var(--color-neutral-50);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .box-image-wrapper picture,
  .box-image-wrapper img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .box-volume-display {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: var(--color-brand-700);
    color: white;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
  }
  .volume-number {
    font-size: var(--text-h3);
    font-weight: 800;
    font-family: var(--font-display);
  }
  .volume-unit {
    font-size: var(--text-sm);
    font-weight: 600;
    opacity: 0.8;
  }

  .box-demo-tag {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-neutral-500);
    border: 1px solid var(--color-neutral-300);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1rem;
  }

  .box-info h1 {
    margin-bottom: 0.75rem;
  }

  .box-desc {
    font-size: var(--text-body-lg);
    color: var(--color-neutral-600);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .box-specs {
    margin-bottom: 2rem;
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    font-size: var(--text-sm);
  }
  .spec-row:not(:last-child) {
    border-bottom: 1px solid var(--color-neutral-100);
  }
  .spec-label { color: var(--color-neutral-500); }
  .spec-value {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .box-objects {
    margin-bottom: 2rem;
  }
  .box-objects h3 {
    font-size: var(--text-body);
    margin-bottom: 0.75rem;
  }
  .box-objects ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .box-objects li {
    padding: 0.375rem 0;
    font-size: var(--text-sm);
    color: var(--color-neutral-600);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .box-objects li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-brand-400);
    flex-shrink: 0;
  }

  .box-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .box-disclaimer {
    font-size: var(--text-xs);
    color: var(--color-neutral-400);
    font-style: italic;
    line-height: 1.5;
  }
</style>
