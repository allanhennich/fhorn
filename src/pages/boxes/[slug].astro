---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getActiveBoxes } from '../../data/admin/boxes';
import { siteConfig } from '../../config/site';

const { slug } = Astro.params;
const allBoxes = await getActiveBoxes();
const unit = allBoxes.find(b => b.slug === slug);

if (!unit) {
  return Astro.redirect('/404');
}

const whatsappUrl = `https://wa.me/${siteConfig.contact.whatsappRaw}?text=${encodeURIComponent(`Olá! Tenho interesse no ${unit.name} (${unit.volumeLabel}). Gostaria de mais informações.`)}`;

function formatDimensions(u: any) { return u.dimensionLabel; }
function floorArea(u: any) { return u.dimensions.width * u.dimensions.depth; }
function formatMeters(n: number) { return n.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
---

<BaseLayout
  title={`${unit.name} - ${unit.volumeLabel}`}
  description={`${unit.name}: ${unit.description} Dimensões: ${formatDimensions(unit)}. Self Storage em Florianópolis.`}
  image={unit.image.fallback}
>
  <section class="section" style="padding-top: 7rem;">
    <div class="container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Início</a></li>
          <li><a href="/boxes/">Nossos Espaços</a></li>
          <li aria-current="page">{unit.name}</li>
        </ol>
      </nav>

      <div class="box-detail">
        <!-- Visual -->
        <div class="box-visual">
          <div class="box-image-wrapper">
            <picture>
              <source srcset={unit.image.src} type="image/webp" />
              <img
                src={unit.image.fallback}
                alt={unit.image.alt}
                width={unit.image.width}
                height={unit.image.height}
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
          <div class="box-volume-display box-volume-desktop">
            <span class="volume-number">{unit.volumeLabel.replace(' m³', '')}</span>
            <span class="volume-unit">m³</span>
          </div>
          <div class="box-volume-display box-volume-mobile">
            <span class="volume-number">{unit.volumeLabel.replace(' m³', '')}</span>
            <span class="volume-unit">m³</span>
          </div>
          <button class="box-share-btn" id="shareBtn" data-title={`${unit.name} - ${unit.volumeLabel} | F.Horn Self Storage`} data-url={`https://www.fhorn.com.br/boxes/${unit.slug}/`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/></svg>
            Compartilhar
          </button>
        </div>

        <!-- Info -->
        <div class="box-info">
          <div class="box-demo-tag">Medidas demonstrativas</div>
          <h1>{unit.name}</h1>
          <p class="box-desc">{unit.description}</p>

          <div class="box-specs">
            <div class="spec-row">
              <span class="spec-label">Dimensões (L × A × P)</span>
              <span class="spec-value">{formatDimensions(unit)}</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">Volume</span>
              <span class="spec-value">{unit.volumeLabel}</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">Área de piso</span>
              <span class="spec-value">{formatMeters(floorArea(unit))} m²</span>
            </div>
          </div>

          <div class="box-objects">
            <h3>O que cabe neste espaço</h3>
            <ul>
              {unit.sampleItems.map((obj) => (
                <li>{obj}</li>
              ))}
            </ul>
          </div>

          <div class="box-actions">
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
              Quero Esse
            </a>
            <a href="/simulador-de-espaco/" class="btn btn-secondary btn-lg">
              Simular com objetos
            </a>
          </div>

          <p class="box-disclaimer">
            As medidas e volumes apresentados são demonstrativos e podem não corresponder à disponibilidade real. Consulte nossa equipe para informações atualizadas.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .breadcrumb ol {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    font-size: var(--text-sm);
    color: var(--color-neutral-500);
  }
  .breadcrumb li:not(:last-child)::after {
    content: '/';
    margin-left: 0.5rem;
    color: var(--color-neutral-300);
  }
  .breadcrumb a {
    color: var(--color-neutral-500);
    text-decoration: none;
  }
  .breadcrumb a:hover { color: var(--color-brand-600); }

  .box-detail {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 768px) {
    .box-detail {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .box-visual {
    position: relative;
  }

  .box-image-wrapper {
    background: var(--color-neutral-50);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .box-image-wrapper picture,
  .box-image-wrapper img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .box-volume-display {
    background: var(--color-brand-700);
    color: white;
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
  }

  .box-volume-desktop {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    display: none;
  }

  .box-volume-mobile {
    padding: 0.625rem 1rem;
    border-radius: var(--radius-md);
    justify-content: center;
    margin-top: 0.75rem;
  }

  @media (min-width: 1024px) {
    .box-volume-desktop {
      display: flex;
    }
    .box-volume-mobile {
      display: none;
    }
  }

  .box-share-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    margin-top: 0.75rem;
    padding: 0.625rem 1rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-brand-700);
    background: var(--color-brand-50);
    border: 1px solid var(--color-brand-200);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }

  .box-share-btn:hover {
    background: var(--color-brand-100);
    color: var(--color-brand-800);
  }

  .box-share-btn svg {
    flex-shrink: 0;
  }

  .volume-number {
    font-size: var(--text-h3);
    font-weight: 800;
    font-family: var(--font-display);
  }
  .volume-unit {
    font-size: var(--text-sm);
    font-weight: 600;
    opacity: 0.8;
  }

  .box-demo-tag {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-neutral-500);
    border: 1px solid var(--color-neutral-300);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1rem;
  }

  .box-info h1 {
    margin-bottom: 0.75rem;
  }

  .box-desc {
    font-size: var(--text-body-lg);
    color: var(--color-neutral-600);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .box-specs {
    margin-bottom: 2rem;
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    font-size: var(--text-sm);
  }
  .spec-row:not(:last-child) {
    border-bottom: 1px solid var(--color-neutral-100);
  }
  .spec-label { color: var(--color-neutral-500); }
  .spec-value {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .box-objects {
    margin-bottom: 2rem;
  }
  .box-objects h3 {
    font-size: var(--text-body);
    margin-bottom: 0.75rem;
  }
  .box-objects ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .box-objects li {
    padding: 0.375rem 0;
    font-size: var(--text-sm);
    color: var(--color-neutral-600);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .box-objects li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-brand-400);
    flex-shrink: 0;
  }

  .box-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .box-disclaimer {
    font-size: var(--text-xs);
    color: var(--color-neutral-400);
    font-style: italic;
    line-height: 1.5;
  }
</style>

<script is:inline>
  document.getElementById('shareBtn')?.addEventListener('click', async function() {
    const title = this.dataset.title;
    const url = this.dataset.url;
    const text = `Confira o ${title} na F.Horn Self Storage!`;

    if (navigator.share) {
      try {
        await navigator.share({ title, text, url });
      } catch (e) {
        // User cancelled
      }
    } else {
      try {
        await navigator.clipboard.writeText(url);
        const original = this.innerHTML;
        this.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Link copiado!';
        this.style.color = '#16a34a';
        setTimeout(() => {
          this.innerHTML = original;
          this.style.color = '';
        }, 2000);
      } catch {
        window.open('https://wa.me/?text=' + encodeURIComponent(text + ' ' + url), '_blank');
      }
    }
  });
</script>
