---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getActiveBoxes } from '../../data/admin/boxes';
import StorageCard from '../../components/storage/StorageCard.astro';

const storageUnits = await getActiveBoxes();
---

<BaseLayout
  title="Nossos Espaços"
  description="Conheça os 8 tamanhos de box disponíveis na F.Horn Self Storage em Florianópolis. De 3 m³ a 11 m³, encontre o espaço ideal."
>
  <section class="section" style="padding-top: 7rem;">
    <div class="container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Início</a></li>
          <li aria-current="page">Nossos Espaços</li>
        </ol>
      </nav>

      <div class="page-header">
        <span class="section-label">Nossos espaços</span>
        <h1>Boxes disponíveis</h1>
        <p class="page-intro">
          Oferecemos diferentes tamanhos de box para atender desde pequenos volumes até mudanças completas.
        </p>
      </div>

      <div class="boxes-list">
        {storageUnits.map((unit, i) => (
          <StorageCard unit={unit} eager={i < 2} />
        ))}
      </div>

      <div class="boxes-cta">
        <p>Não tem certeza sobre o tamanho ideal?</p>
        <a href="/simulador-de-espaco/" class="btn btn-primary btn-lg">
          Use nosso simulador de espaço
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .breadcrumb ol {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    font-size: var(--text-sm);
    color: var(--color-neutral-500);
  }
  .breadcrumb li:not(:last-child)::after {
    content: '/';
    margin-left: 0.5rem;
    color: var(--color-neutral-300);
  }
  .breadcrumb a {
    color: var(--color-neutral-500);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--color-brand-600);
  }

  .page-header {
    max-width: 560px;
    margin-bottom: 3rem;
  }
  .page-intro {
    font-size: var(--text-body-lg);
    color: var(--color-neutral-600);
    margin-top: 0.75rem;
  }

  .boxes-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .boxes-cta {
    text-align: center;
    margin-top: 3rem;
    padding: 2rem;
    background: var(--color-neutral-50);
    border-radius: var(--radius-lg);
  }
  .boxes-cta p {
    margin-bottom: 1rem;
    color: var(--color-neutral-600);
  }
</style>
