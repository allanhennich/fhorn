---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoHero from '../components/home/VideoHero.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import StorageSection from '../components/home/StorageSection.astro';
import ServicesOverview from '../components/home/ServicesOverview.astro';
import CalculatorPreview from '../components/home/CalculatorPreview.astro';
import { siteConfig } from '../config/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': siteConfig.url,
  name: siteConfig.name,
  description: siteConfig.seo.defaultDescription,
  url: siteConfig.url,
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteConfig.address.street,
    addressLocality: siteConfig.address.city,
    addressRegion: siteConfig.address.state,
    postalCode: siteConfig.address.zip,
    addressCountry: siteConfig.address.country,
  },
  telephone: siteConfig.contact.phone,
  priceRange: '$$',
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '08:00',
    closes: '18:00',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -27.5956,
    longitude: -48.5744,
  },
  areaServed: {
    '@type': 'City',
    name: 'Florianópolis',
  },
  sameAs: [
    siteConfig.social.instagram,
    siteConfig.social.linkedin,
  ],
};
---

<BaseLayout jsonLd={jsonLd} headerVariant="transparent">
  <VideoHero />
  <HowItWorks />
  <StorageSection />
  <ServicesOverview />
  <CalculatorPreview />
</BaseLayout>
