---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpaceCalculator from '../../components/calculator/SpaceCalculator.tsx';
import '../../components/calculator/calculator.css';
---

<BaseLayout
  title="Simulador de Espaço"
  description="Descubra o box ideal para seus objetos. Selecione o que precisa armazenar e receba uma estimativa de espaço para guarda móveis e self storage."
>
  <section class="section" style="padding-top: 7rem;">
    <div class="container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Início</a></li>
          <li aria-current="page">Simulador de Espaço</li>
        </ol>
      </nav>

      <div class="page-header" style="text-align: center; max-width: 560px; margin: 0 auto 3rem;">
        <span class="section-label">Simulador</span>
        <h1>Descubra o espaço ideal para você</h1>
        <p style="font-size: var(--text-body-lg); color: var(--color-neutral-600); margin-top: 0.75rem;">
          Selecione os objetos que pretende guardar e receba uma estimativa do box mais adequado.
        </p>
      </div>

      <SpaceCalculator client:load />
    </div>
  </section>
</BaseLayout>

<style>
  .breadcrumb ol {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    font-size: var(--text-sm);
    color: var(--color-neutral-500);
  }
  .breadcrumb li:not(:last-child)::after {
    content: '/';
    margin-left: 0.5rem;
    color: var(--color-neutral-300);
  }
  .breadcrumb a { color: var(--color-neutral-500); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-brand-600); }
</style>
