---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) =>
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);
---

<BaseLayout
  title="Blog"
  description="Dicas e informações sobre guarda móveis, self storage, armazenamento e organização em Florianópolis."
>
  <section class="section" style="padding-top: 7rem;">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Início</a></li>
          <li aria-current="page">Blog</li>
        </ol>
      </nav>

      <div class="page-header">
        <span class="section-label">Blog</span>
        <h1>Artigos e dicas</h1>
        <p class="page-intro">
          Informações úteis sobre armazenamento, organização e guarda móveis.
        </p>
      </div>

      <div class="blog-grid">
        {sortedPosts.map((post) => (
          <article class="blog-card">
            <a href={`/blog/${post.id}/`} class="blog-card-link">
              <div class="blog-card-content">
                <time class="blog-card-date" datetime={post.data.publishDate}>
                  {new Date(post.data.publishDate).toLocaleDateString('pt-BR', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric',
                  })}
                </time>
                <h2 class="blog-card-title">{post.data.title}</h2>
                <p class="blog-card-excerpt">{post.data.description}</p>
                <span class="blog-card-read">Ler artigo &rarr;</span>
              </div>
            </a>
          </article>
        ))}
      </div>

      {sortedPosts.length === 0 && (
        <p style="text-align: center; color: var(--color-neutral-500);">
          Em breve novos artigos serão publicados.
        </p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .breadcrumb ol {
    display: flex; gap: 0.5rem; list-style: none; padding: 0; margin: 0 0 2rem;
    font-size: var(--text-sm); color: var(--color-neutral-500);
  }
  .breadcrumb li:not(:last-child)::after { content: '/'; margin-left: 0.5rem; color: var(--color-neutral-300); }
  .breadcrumb a { color: var(--color-neutral-500); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-brand-600); }

  .page-header { margin-bottom: 3rem; }
  .page-intro { font-size: var(--text-body-lg); color: var(--color-neutral-600); margin-top: 0.75rem; }

  .blog-grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 640px) { .blog-grid { grid-template-columns: repeat(2, 1fr); } }

  .blog-card {
    border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg);
    overflow: hidden; transition: border-color var(--duration-normal);
  }
  .blog-card:hover { border-color: var(--color-brand-300); }

  .blog-card-link { text-decoration: none; color: inherit; display: block; }

  .blog-card-content { padding: 1.5rem; }

  .blog-card-date {
    font-size: var(--text-xs); color: var(--color-neutral-500);
    text-transform: uppercase; letter-spacing: 0.05em;
  }

  .blog-card-title {
    font-size: var(--text-h4); margin: 0.5rem 0; line-height: 1.3;
  }

  .blog-card-excerpt {
    font-size: var(--text-sm); color: var(--color-neutral-600); line-height: 1.5;
    margin-bottom: 1rem;
  }

  .blog-card-read {
    font-size: var(--text-sm); font-weight: 600; color: var(--color-brand-600);
  }
</style>
