---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página não encontrada" noindex={true}>
  <section class="error-page">
    <div class="container">
      <span class="error-code">404</span>
      <h1>Página não encontrada</h1>
      <p>O endereço que você acessou não existe ou foi removido.</p>
      <div class="error-actions">
        <a href="/" class="btn btn-primary btn-lg">Voltar ao início</a>
        <a href="/contato/" class="btn btn-ghost btn-lg">Fale conosco</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .error-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 70vh;
    text-align: center;
  }
  .error-code {
    font-family: var(--font-display);
    font-size: 6rem;
    font-weight: 800;
    color: var(--color-neutral-200);
    line-height: 1;
    display: block;
    margin-bottom: 1rem;
  }
  .error-page h1 { margin-bottom: 0.75rem; }
  .error-page p { color: var(--color-neutral-500); margin-bottom: 2rem; font-size: var(--text-body-lg); }
  .error-actions { display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap; }
</style>
